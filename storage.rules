rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : "";
    }

    function isStaff() {
      return signedIn() && (
        request.auth.token.admin == true ||
        role() in ["admin", "leader", "sga", "program", "mentor", "trainer"]
      );
    }

    function isAllowedDoc() {
      return request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType.matches(
          "application/pdf|text/csv|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.*|image/.*"
        );
    }

    match /public-assets/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isAllowedDoc();
    }

    match /programs/{programId}/documents/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isAllowedDoc();
    }

    match /startups/{startupId}/documents/{allPaths=**} {
      allow read: if isStaff() || (
        signedIn() &&
        request.auth.token.startupIds is list &&
        startupId in request.auth.token.startupIds
      );
      allow write: if isStaff() && isAllowedDoc();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
