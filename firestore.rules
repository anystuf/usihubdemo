rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : "";
    }

    function hasAdminClaim() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isAdmin() {
      return hasAdminClaim() || role() in ["admin", "leader"];
    }

    function isStaff() {
      return isAdmin() || role() in ["sga", "program", "mentor", "trainer"];
    }

    function isFounder() {
      return role() == "founder";
    }

    function inUserPrograms(programId) {
      return signedIn() &&
        request.auth.token.programIds is list &&
        programId in request.auth.token.programIds;
    }

    function ownsStartup(startupId) {
      return signedIn() &&
        request.auth.token.startupIds is list &&
        startupId in request.auth.token.startupIds;
    }

    function canReadProgramDoc() {
      return isStaff() || inUserPrograms(resource.data.programId);
    }

    function canReadStartupDoc() {
      return isStaff() || ownsStartup(resource.data.startupId);
    }

    function publicDemoRead() {
      return true;
    }

    function hasOnlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validBaseDoc() {
      return hasRequiredFields(["schemaVersion", "programId", "visibility"]);
    }

    function validStartup() {
      return validBaseDoc() &&
        hasRequiredFields(["name", "stage", "sector", "riskLevel", "healthScore", "summary"]);
    }

    function validDocument() {
      return validBaseDoc() &&
        hasRequiredFields(["title", "type", "startup", "indexedStatus", "permissionLevel"]);
    }

    function validTask() {
      return validBaseDoc() &&
        hasRequiredFields(["title", "assignee", "due", "status", "progress"]);
    }

    function validFounderQuestionCreate() {
      return validBaseDoc() &&
        hasRequiredFields(["question", "startup", "status"]) &&
        request.resource.data.status in ["open", "answered", "archived"];
    }

    function validAiProposalCreate() {
      return validBaseDoc() &&
        hasRequiredFields([
          "type",
          "prompt",
          "answer",
          "evidence",
          "sources",
          "confidence",
          "missingData",
          "nextActions",
          "approvalStatus",
          "createdBy"
        ]) &&
        request.resource.data.approvalStatus == "pending";
    }

    match /platformConfig/{docId} {
      allow read: if publicDemoRead();
      allow create, update, delete: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if publicDemoRead();
      allow create, update, delete: if isAdmin();
    }

    match /cohorts/{cohortId} {
      allow read: if publicDemoRead();
      allow create, update, delete: if isAdmin();
    }

    match /startups/{startupId} {
      allow read: if publicDemoRead();
      allow create, update: if isStaff() && validStartup();
      allow delete: if isAdmin();
    }

    match /documents/{documentId} {
      allow read: if publicDemoRead();
      allow create, update: if isStaff() && validDocument();
      allow delete: if isAdmin();
    }

    match /projectTasks/{taskId} {
      allow read: if publicDemoRead();
      allow create, update: if isStaff() && validTask();
      allow delete: if isAdmin();
    }

    match /aiInsights/{insightId} {
      allow read: if publicDemoRead();
      allow create, update: if isStaff() && validBaseDoc();
      allow delete: if isAdmin();
    }

    match /sourceFiles/{sourceId} {
      allow read: if publicDemoRead();
      allow create, update: if isStaff() &&
        validBaseDoc() &&
        hasRequiredFields(["file", "use"]);
      allow delete: if isAdmin();
    }

    match /founderQuestions/{questionId} {
      allow read: if publicDemoRead();
      allow create: if signedIn() && validFounderQuestionCreate();
      allow update: if isStaff() || (
        isFounder() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["question", "tags", "updatedAt"])
      );
      allow delete: if isStaff();
    }

    match /mentorSessions/{sessionId} {
      allow read: if canReadProgramDoc() || canReadStartupDoc();
      allow create, update: if isStaff() && validBaseDoc();
      allow delete: if isAdmin();
    }

    match /workshops/{workshopId} {
      allow read: if publicDemoRead();
      allow create, update: if isStaff() && validBaseDoc();
      allow delete: if isAdmin();
    }

    match /aiProposals/{proposalId} {
      allow read: if isStaff() || canReadStartupDoc();
      allow create: if signedIn() && validAiProposalCreate();
      allow update: if isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["approvalStatus", "approvedBy", "approvedAt", "updatedAt", "reviewNote"]);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
